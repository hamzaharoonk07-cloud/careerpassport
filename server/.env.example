# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5273

# ── Database ───────────────────────────────────────────
# Leave MONGO_URI empty in development to boot an in-memory
# MongoDB automatically (mongodb-memory-server).
# For a real cluster, paste your Atlas connection string here.
MONGO_URI=
MONGO_DB_NAME=pathseeker

# ── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ── Owners ─────────────────────────────────────────────
# Comma-separated addresses that always hold the admin role. Applied on
# registration and re-applied on every boot, so the panel does not vanish
# when the in-memory database resets.
ADMIN_EMAILS=

# ── Owner account ──────────────────────────────────────
# Seeded on every boot with the admin role. Leave blank to seed no owner.
# Never commit a real password here — this file ships, .env does not.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
